# Copy this file to .env.local and fill in the values. .env.local is never committed.

# ---- The website needs these ---------------------------------------------------

# The live address of the site. Used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Project URL, such as https://abcdefgh.supabase.co
# In Supabase: the Connect button at the top of your project.
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key (sb_publishable_...). Safe in the browser: Row Level Security protects the data.
# In Supabase: the same Connect dialog, or Settings > API Keys.
# An older project may only have an anon key: put that in NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Only the setup commands need these. They never go to the browser or the host ----

# The secret key (sb_secret_...). Used by npm run cms:seed and npm run cms:create-admin.
# In Supabase: Settings > API Keys. An older project may only have a service_role key: put
# that in SUPABASE_SERVICE_ROLE_KEY instead.
# It bypasses every security rule: never give it a NEXT_PUBLIC_ name, and never commit it.
SUPABASE_SECRET_KEY=

# Connection string. Used only by npm run cms:migrate, and can be removed afterwards.
# In Supabase: the Connect button > Session pooler. Leave [YOUR-PASSWORD] as it is: the command asks
# for the database password, hidden, so it is never saved. A forgotten password can be reset in
# Database Settings.
SUPABASE_DB_URL=
